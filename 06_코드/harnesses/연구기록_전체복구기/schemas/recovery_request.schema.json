{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project_root", "source_selection", "strict"],
  "properties": {
    "project_root": {"type": "string", "minLength": 1},
    "codex_home": {"type": ["string", "null"]},
    "source_selection": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["project_path_match", "explicit_session_ids", "all_discovered"]},
        "session_ids": {"type": "array", "items": {"type": "string"}},
        "extra_transcripts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "copy_raw": {"type": "boolean"},
    "strict": {"type": "boolean"},
    "double_review": {"type": "boolean"}
  },
  "additionalProperties": false
}
